{
  "name": "helios",
  "version": "0.8.0",
  "private": true,
  "description": "Deploy to Sealos — agent-first.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @helios/electron",
    "dev:eve": "npm run dev -w eve",
    "ios": "npm run ios -w @helios/mobile",
    "typecheck": "npm run typecheck -w @helios/electron && npm run typecheck -w eve && npm run typecheck -w @helios/mobile",
    "lint": "npm run lint -w @helios/electron",
    "format": "npm run format -w @helios/electron",
    "build:mac": "npm run build:mac -w @helios/electron",
    "publish:mac": "node apps/electron/scripts/publish-mac.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "ai": "^7.0.58"
  }
}
